        <mxCell id="m_rfcs" value="Bandejas por Estatus RFC&#xa;• En Espera de VOBO (Checklist QAS)&#xa;• Aprobados (Preparacion y Bloqueo Horario)&#xa;• En Ejecucion (Edicion en Caliente Protegida)&#xa;• Finalizados con Exito / Cancelados / Acciones Batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_modules">
