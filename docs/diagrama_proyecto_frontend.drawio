        </mxCell>

        <mxCell id="r_tqs_bkp" value="TQS Leader — [Mis Sistemas &amp; Backup]&#xa;• Herencia de titular (tqs_users.backup_tqs_id)&#xa;• Ve sistemas individuales y RFCs del titular&#xa;• Seccion dedicada en sidebar: Sistemas Backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#92400e;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_roles">
