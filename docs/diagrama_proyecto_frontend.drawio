        <mxCell id="m_admin" value="Gobernanza y Auditoria (Admin)&#xa;• Catalogo de 54 Sistemas Maestros (Individuales)&#xa;• Transferencia TQS Titular / Backup&#xa;• Gestion Usuarios RBAC y Reseteo Claves&#xa;• Logs 360° (Auditoria DB + App Logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f2b5c;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_modules">
