        <mxCell id="m_dash" value="Dashboard Ejecutivo &amp; KPIs&#xa;• Tasa de Exito, Total Ventanas, Alertas&#xa;• Grafico Tendencia Mensual &amp; Dona Carga&#xa;• Desglose por TQS y Nivel de Criticidad&#xa;• Exportacion CSV (General / Filtrado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_modules">
