        <mxCell id="m_alertas" value="Alertas Activas &amp; Solicitudes&#xa;• Ventanas Proximas (Horizonte 7 dias)&#xa;• RFCs vencidos sin cierre oportuno&#xa;• Tickets KOF/EAS: KIT, Incidente, RCA, Req.&#xa;• Bitacora de seguimiento y Action Items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_modules">
