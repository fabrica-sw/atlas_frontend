        <mxCell id="r_fte" value="FTE / Guardia Fin de Semana&#xa;• Lectura por siguiendo_tqs o ventanas activas&#xa;• Alertas Activas (7d) y Bandeja de Solicitudes&#xa;• Ejecucion y cierre operativo de cambios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#166534;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_roles">
