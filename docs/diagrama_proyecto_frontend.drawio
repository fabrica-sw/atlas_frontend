        </mxCell>

        <!-- CAPA A: PERFILES DE ACCESO Y PERSPECTIVA TQS -->
        <mxCell id="lane_roles" value="1. PERFILES RBAC Y MODO DE PERSPECTIVA EN INTERFAZ (CURRENT_USER)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f2b5c;fontStyle=1;fontSize=11;startSize=28;" vertex="1" parent="1">
