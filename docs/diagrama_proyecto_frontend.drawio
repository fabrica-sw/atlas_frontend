        <mxCell id="r_admin" value="Admin / Director&#xa;• Vista Global de los 54 Sistemas KOF&#xa;• Gobernanza: Catalogo, Usuarios, Logs 360°&#xa;• Atlas Copilot IA &amp; Transferencia TQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f2b5c;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_roles">
          <mxGeometry x="20" y="38" width="290" height="72" as="geometry" />
        </mxCell>

        <mxCell id="r_tqs_iso" value="TQS Leader — [Solo Mi Perfil TQS]&#xa;• Aislamiento estricto (owner_id / tqs_ids)&#xa;• KPIs personales sin inflacion de backups&#xa;• Sidebar: SAP + No SAP propios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="lane_roles">
