        <!-- BANNER TITULO -->
        <mxCell id="fe_title" value="ATLAS Platform v3.0 — Diagrama del Proyecto Frontend (SPA Operativa SAP)&#xa;EAS Consulting Group · Repositorio: eaguilarh01/atlas_frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2b5c;strokeColor=#0f2b5c;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
